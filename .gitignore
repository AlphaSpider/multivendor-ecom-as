# ---------------------------------------------------------------------------
# ManzilCart
# ---------------------------------------------------------------------------

# Python virtual environment
venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment / secrets - never commit these
.env
.env.*
!.env.example

# Local database files (PostgreSQL is used, but keep this safe)
*.sqlite3
*.db

# Uploaded media (user supplied content must not live in git)
Manzilcart/media/

# Collected static files
Manzilcart/staticfiles/

# Test and coverage artefacts
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Editors / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Build artefacts
build/
dist/
*.egg-info/

# Local notes that may contain credentials
*.local.md
