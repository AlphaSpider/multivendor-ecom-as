# ---------------------------------------------------------------------------
# ManzilCart environment template.
# Copy to `.env` (which is git-ignored) and fill in real values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# development | testing | production
DJANGO_ENV=development
DJANGO_DEBUG=true

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma separated. Required when DJANGO_ENV=production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated, e.g. https://manzilcart.ae
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database --------------------------------------------------------------
DB_ENGINE=postgresql
DB_NAME=manzilsample
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Cache / channel layer -------------------------------------------------
# Leave empty in development to use the in-process cache and channel layer.
# Redis is required in production (multiple processes must share state).
REDIS_URL=

# --- Email -----------------------------------------------------------------
# Development prints email to the console. In production set EMAIL_HOST etc.
DEFAULT_FROM_EMAIL=ManzilCart <no-reply@manzilcart.local>
ADMINS_EMAILS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- HTTPS (production) ----------------------------------------------------
# TLS terminates at the proxy; Django trusts X-Forwarded-Proto for HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Notifications ---------------------------------------------------------
# mock = record notifications without contacting a provider (development/staging)
# live = use the real WhatsApp / SMS / email providers
NOTIFICATIONS_MODE=mock
OPS_TEAM_EMAIL=operations@manzilcart.local
# Live providers are only used when NOTIFICATIONS_MODE=live. Leave blank until
# the accounts and approved message templates exist; the backends fail loudly.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=manzilcart_otp
SMS_API_KEY=

# --- Mobile OTP ------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# --- Auctions --------------------------------------------------------------
AUCTION_CONFIRMATION_WINDOW_HOURS=6
AUCTION_MIN_DURATION_HOURS=1
AUCTION_MAX_DURATION_DAYS=14
AUCTION_MIN_BID_INCREMENT=1
AUCTION_MAX_BIDS_PER_USER=50
AUCTIONS_PER_PAGE=20

# --- Misc ------------------------------------------------------------------
TIME_ZONE=Asia/Dubai
DJANGO_LOG_LEVEL=INFO
MEDIA_ROOT=
